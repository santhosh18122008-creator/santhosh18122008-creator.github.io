---
import '@fontsource-variable/inter';
import Head from '../components/seo/Head.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieConsent from '../components/layout/CookieConsent.astro';
import { monetization } from '../config/monetization';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} canonical={canonical} />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <script is:inline define:vars={{ enabled: monetization.adsenseEnabled, pubId: monetization.adsensePublisherId }}>
      (function () {
        if (!enabled || !pubId) return;
        if (localStorage.getItem('md-consent') !== 'granted') return;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + pubId;
        s.crossOrigin = 'anonymous';
        document.head.appendChild(s);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <Header />
    <main class="mx-auto w-full max-w-5xl flex-1 px-4">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
