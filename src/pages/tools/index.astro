---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIcon from '../../components/ui/ToolIcon.astro';
import { publishedTools } from '../../content/tools';

const categoryOrder = ['student-tools', 'general-utilities', 'physics-tools', 'everyday-tools', 'finance-tools', 'health-tools'];
const categoryLabels: Record<string, string> = {
  'student-tools': 'Student',
  'general-utilities': 'Utilities',
  'physics-tools': 'Physics',
  'everyday-tools': 'Dates',
  'finance-tools': 'Finance',
  'health-tools': 'Health',
};
---
<BaseLayout
  title="All Tools — Free Online Calculators and Utilities | MarqDesk"
  description="Browse all free MarqDesk tools. Simple, fast calculators and utilities for students and everyday tasks. No account required."
>
  <div class="py-12 sm:py-14">
    <h1 class="font-display text-4xl font-semibold tracking-tight">All tools</h1>
    <p class="mt-2 text-soft">{publishedTools.length} free tools. Every one runs in your browser, with no account and nothing to install.</p>
  </div>

  <div class="sticky top-16 z-30 -mx-4 border-y border-ink/10 bg-paper/90 px-4 py-3 backdrop-blur">
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-cat-btn="all" class="cat-btn is-active">All</button>
      {categoryOrder.map((c) => (
        <button type="button" data-cat-btn={c} class="cat-btn">{categoryLabels[c]}</button>
      ))}
      <input
        id="tool-search"
        type="search"
        placeholder="Search tools"
        aria-label="Search tools"
        class="field ml-auto w-full max-w-[200px]"
      />
    </div>
  </div>

  <div class="grid gap-4 py-8 sm:grid-cols-2 lg:grid-cols-3">
    {publishedTools.map((tool) => (
      <a
        href={'/tools/' + tool.slug + '/'}
        data-tool-card
        data-cat={tool.category}
        data-name={(tool.title + ' ' + tool.shortDescription).toLowerCase()}
        class="card-paper group flex flex-col p-5"
      >
        <span class="text-soft transition-colors duration-150 group-hover:text-desk"><ToolIcon name={tool.slug} class="h-5 w-5" /></span>
        <h2 class="mt-3 font-semibold">{tool.title}</h2>
        <p class="mt-1 text-sm leading-relaxed text-soft">{tool.shortDescription}</p>
      </a>
    ))}
  </div>
  <p id="tool-empty" class="hidden pb-8 text-sm text-soft">No tools match that search. Try a different word, or browse a category above.</p>

  <script is:inline>
    (function () {
      var input = document.getElementById('tool-search');
      var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-cat-btn]'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('[data-tool-card]'));
      var empty = document.getElementById('tool-empty');
      var currentCat = 'all';
      function apply() {
        var q = input ? input.value.toLowerCase() : '';
        var visible = 0;
        cards.forEach(function (card) {
          var okCat = currentCat === 'all' || card.getAttribute('data-cat') === currentCat;
          var okQ = !q || (card.getAttribute('data-name') || '').indexOf(q) !== -1;
          var show = okCat && okQ;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (empty) empty.classList.toggle('hidden', visible !== 0);
      }
      if (input) input.addEventListener('input', apply);
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          currentCat = btn.getAttribute('data-cat-btn') || 'all';
          buttons.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
          apply();
        });
      });
    })();
  </script>
</BaseLayout>
