---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolIcon from '../../components/ui/ToolIcon.astro';
import { publishedTools } from '../../content/tools';

const categoryOrder = ['student-tools', 'general-utilities', 'physics-tools', 'everyday-tools', 'finance-tools'];
const categoryLabels: Record<string, string> = {
  'student-tools': 'Student Tools',
  'general-utilities': 'Everyday Utilities',
  'physics-tools': 'Physics & Engineering',
  'everyday-tools': 'Date & Time',
  'finance-tools': 'Money & Finance',
};
const groups = categoryOrder
  .map((c) => ({ category: c, label: categoryLabels[c], tools: publishedTools.filter((t) => t.category === c) }))
  .filter((g) => g.tools.length > 0);
---
<BaseLayout
  title="All Tools — Free Online Calculators & Utilities | MarqDesk"
  description="Browse all free MarqDesk tools. Simple, fast calculators and utilities for students and everyday tasks. No account required."
>
  <div class="py-12 text-center sm:py-16">
    <h1 class="text-4xl font-extrabold tracking-tight">All tools</h1>
    <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">
      {publishedTools.length} free tools. Every one runs in your browser — no account, no install.
    </p>
  </div>

  {groups.map((group) => (
    <section class="mt-10" aria-labelledby={'tools-' + group.category}>
      <h2 id={'tools-' + group.category} class="text-xl font-bold tracking-tight">{group.label}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {group.tools.map((tool) => (
          <a href={'/tools/' + tool.slug + '/'} class="card group flex flex-col p-5">
            <div class="flex items-start justify-between">
              <span class="icon-badge"><ToolIcon name={tool.slug} /></span>
              <span class="text-xs font-semibold text-slate-400">Free</span>
            </div>
            <h3 class="mt-4 font-bold text-slate-900 dark:text-white">{tool.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{tool.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  <div class="h-4"></div>
</BaseLayout>
