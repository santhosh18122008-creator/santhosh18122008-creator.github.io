---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedTools, getTool } from '../../content/tools';
import PercentageCalculator from '../../components/islands/PercentageCalculator.tsx';
import GradeCalculator from '../../components/islands/GradeCalculator.tsx';
import GpaCalculator from '../../components/islands/GpaCalculator.tsx';
import AttendanceCalculator from '../../components/islands/AttendanceCalculator.tsx';
import AverageCalculator from '../../components/islands/AverageCalculator.tsx';
import StudyTimer from '../../components/islands/StudyTimer.tsx';
import UnitConverter from '../../components/islands/UnitConverter.tsx';
import PasswordGenerator from '../../components/islands/PasswordGenerator.tsx';
import TextCounter from '../../components/islands/TextCounter.tsx';
import QrCodeGenerator from '../../components/islands/QrCodeGenerator.tsx';

export function getStaticPaths() {
  return publishedTools.map((tool) => ({ params: { slug: tool.slug } }));
}

const tool = getTool(Astro.params.slug as string);
if (!tool) return new Response('Not found', { status: 404 });

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: tool.title,
  description: tool.seoDescription, applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any', url: new URL('/tools/' + tool.slug + '/', import.meta.env.SITE).href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<BaseLayout title={tool.seoTitle} description={tool.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <nav aria-label="Breadcrumb" class="mb-4 text-sm text-slate-500">
    <a href="/" class="hover:underline">Home</a> / <a href="/tools/" class="hover:underline">Tools</a> / <span>{tool.title}</span>
  </nav>

  <h1 class="text-3xl font-extrabold text-brand-900 dark:text-brand-100">{tool.title}</h1>
  <p class="mt-3 text-slate-600 dark:text-slate-400">{tool.intro}</p>

  <div class="mt-8">
    {tool.component === 'percentage-calculator' && <PercentageCalculator client:load />}
    {tool.component === 'grade-calculator' && <GradeCalculator client:load />}
    {tool.component === 'gpa-calculator' && <GpaCalculator client:load />}
    {tool.component === 'attendance-calculator' && <AttendanceCalculator client:load />}
    {tool.component === 'average-calculator' && <AverageCalculator client:load />}
    {tool.component === 'study-timer' && <StudyTimer client:load />}
    {tool.component === 'unit-converter' && <UnitConverter client:load />}
    {tool.component === 'password-generator' && <PasswordGenerator client:load />}
    {tool.component === 'text-counter' && <TextCounter client:load />}
    {tool.component === 'qr-generator' && <QrCodeGenerator client:load />}
  </div>

  {tool.sections.map((section) => (
    <section class="mt-10">
      <h2 class="text-xl font-bold">{section.heading}</h2>
      <p class="mt-2 leading-relaxed text-slate-700 dark:text-slate-300">{section.body}</p>
    </section>
  ))}

  <section class="mt-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-xl font-bold">Frequently asked questions</h2>
    <div class="mt-4 space-y-3">
      {tool.faqs.map((faq) => (
        <details class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <summary class="cursor-pointer font-semibold">{faq.q}</summary>
          <p class="mt-2 text-slate-700 dark:text-slate-300">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
