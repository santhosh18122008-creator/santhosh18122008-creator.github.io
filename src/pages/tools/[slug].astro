---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import ToolIcon from '../../components/ui/ToolIcon.astro';
import { publishedTools, getTool } from '../../content/tools';
import PercentageCalculator from '../../components/islands/PercentageCalculator.tsx';
import GradeCalculator from '../../components/islands/GradeCalculator.tsx';
import GpaCalculator from '../../components/islands/GpaCalculator.tsx';
import AttendanceCalculator from '../../components/islands/AttendanceCalculator.tsx';
import AverageCalculator from '../../components/islands/AverageCalculator.tsx';
import StudyTimer from '../../components/islands/StudyTimer.tsx';
import UnitConverter from '../../components/islands/UnitConverter.tsx';
import PasswordGenerator from '../../components/islands/PasswordGenerator.tsx';
import TextCounter from '../../components/islands/TextCounter.tsx';
import QrCodeGenerator from '../../components/islands/QrCodeGenerator.tsx';
import OhmsLawCalculator from '../../components/islands/OhmsLawCalculator.tsx';
import KineticEnergyCalculator from '../../components/islands/KineticEnergyCalculator.tsx';
import PotentialEnergyCalculator from '../../components/islands/PotentialEnergyCalculator.tsx';
import AgeCalculator from '../../components/islands/AgeCalculator.tsx';
import DateDifferenceCalculator from '../../components/islands/DateDifferenceCalculator.tsx';
import DiscountCalculator from '../../components/islands/DiscountCalculator.tsx';
import SimpleInterestCalculator from '../../components/islands/SimpleInterestCalculator.tsx';
import CompoundInterestCalculator from '../../components/islands/CompoundInterestCalculator.tsx';
import EmiCalculator from '../../components/islands/EmiCalculator.tsx';
import TipCalculator from '../../components/islands/TipCalculator.tsx';
import GstCalculator from '../../components/islands/GstCalculator.tsx';
import CgpaToPercentageCalculator from '../../components/islands/CgpaToPercentageCalculator.tsx';
import RankPercentileCalculator from '../../components/islands/RankPercentileCalculator.tsx';
import SpeedDistanceTimeCalculator from '../../components/islands/SpeedDistanceTimeCalculator.tsx';
import BmiCalculator from '../../components/islands/BmiCalculator.tsx';
import RandomNumberGenerator from '../../components/islands/RandomNumberGenerator.tsx';
import SgpaCalculator from '../../components/islands/SgpaCalculator.tsx';
import GradePredictor from '../../components/islands/GradePredictor.tsx';
import CaseConverter from '../../components/islands/CaseConverter.tsx';
import TeamSplitter from '../../components/islands/TeamSplitter.tsx';
import ColorConverter from '../../components/islands/ColorConverter.tsx';
import SipCalculator from '../../components/islands/SipCalculator.tsx';
import CtcToInHandCalculator from '../../components/islands/CtcToInHandCalculator.tsx';
import FreelanceRateCalculator from '../../components/islands/FreelanceRateCalculator.tsx';
import BreakEvenCalculator from '../../components/islands/BreakEvenCalculator.tsx';
import IncomeTaxCalculator from '../../components/islands/IncomeTaxCalculator.tsx';
import CountdownTimer from '../../components/islands/CountdownTimer.tsx';
import WorkingDaysCalculator from '../../components/islands/WorkingDaysCalculator.tsx';
import SleepCycleCalculator from '../../components/islands/SleepCycleCalculator.tsx';
import AgeGapCalculator from '../../components/islands/AgeGapCalculator.tsx';
import TimeAddSubtract from '../../components/islands/TimeAddSubtract.tsx';
import ProjectileMotionCalculator from '../../components/islands/ProjectileMotionCalculator.tsx';
import DensityCalculator from '../../components/islands/DensityCalculator.tsx';
import WorkPowerCalculator from '../../components/islands/WorkPowerCalculator.tsx';
import BmrCalculator from '../../components/islands/BmrCalculator.tsx';
import WaterIntakeCalculator from '../../components/islands/WaterIntakeCalculator.tsx';
import IdealWeightCalculator from '../../components/islands/IdealWeightCalculator.tsx';
import PregnancyDueDateCalculator from '../../components/islands/PregnancyDueDateCalculator.tsx';
import FireCalculator from '../../components/islands/FireCalculator.tsx';
import BodyFatCalculator from '../../components/islands/BodyFatCalculator.tsx';
import HeartRateZonesCalculator from '../../components/islands/HeartRateZonesCalculator.tsx';
import WaistToHipCalculator from '../../components/islands/WaistToHipCalculator.tsx';
import OneRepMaxCalculator from '../../components/islands/OneRepMaxCalculator.tsx';
import PaceCalculator from '../../components/islands/PaceCalculator.tsx';






export function getStaticPaths() {
  return publishedTools.map((tool) => ({ params: { slug: tool.slug } }));
}

const tool = getTool(Astro.params.slug as string);
if (!tool) return new Response('Not found', { status: 404 });

const related = [
  ...publishedTools.filter((t) => t.slug !== tool.slug && t.category === tool.category),
  ...publishedTools.filter((t) => t.slug !== tool.slug && t.category !== tool.category),
].slice(0, 3);

const appLd = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: tool.title,
  description: tool.seoDescription, applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any', url: new URL('/tools/' + tool.slug + '/', import.meta.env.SITE).href,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: tool.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={tool.seoTitle} description={tool.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div class="mx-auto max-w-3xl py-10">
    <nav aria-label="Breadcrumb" class="text-sm text-soft">
      <a href="/" class="hover:text-desk">Home</a> / <a href="/tools/" class="hover:text-desk">Tools</a> / <span>{tool.title}</span>
    </nav>

    <h1 class="font-display mt-4 text-[32px] font-semibold tracking-tight sm:text-[40px]">{tool.title}</h1>
    <p class="mt-2 text-soft">{tool.shortDescription}</p>

    <div class="mt-8">
      {tool.component === 'percentage-calculator' && <PercentageCalculator client:load />}
      {tool.component === 'grade-calculator' && <GradeCalculator client:load />}
      {tool.component === 'gpa-calculator' && <GpaCalculator client:load />}
      {tool.component === 'attendance-calculator' && <AttendanceCalculator client:load />}
      {tool.component === 'average-calculator' && <AverageCalculator client:load />}
      {tool.component === 'study-timer' && <StudyTimer client:load />}
      {tool.component === 'unit-converter' && <UnitConverter client:load />}
      {tool.component === 'password-generator' && <PasswordGenerator client:load />}
      {tool.component === 'text-counter' && <TextCounter client:load />}
      {tool.component === 'qr-generator' && <QrCodeGenerator client:load />}
      {tool.component === 'ohms-law-calculator' && <OhmsLawCalculator client:load />}
      {tool.component === 'kinetic-energy-calculator' && <KineticEnergyCalculator client:load />}
      {tool.component === 'potential-energy-calculator' && <PotentialEnergyCalculator client:load />}
      {tool.component === 'age-calculator' && <AgeCalculator client:load />}
      {tool.component === 'date-difference-calculator' && <DateDifferenceCalculator client:load />}
      {tool.component === 'discount-calculator' && <DiscountCalculator client:load />}
      {tool.component === 'simple-interest-calculator' && <SimpleInterestCalculator client:load />}
      {tool.component === 'compound-interest-calculator' && <CompoundInterestCalculator client:load />}
      {tool.component === 'emi-calculator' && <EmiCalculator client:load />}
      {tool.component === 'tip-calculator' && <TipCalculator client:load />}
      {tool.component === 'gst-calculator' && <GstCalculator client:load />}
    {tool.component === 'cgpa-to-percentage' && <CgpaToPercentageCalculator client:load />}
    {tool.component === 'rank-percentile-calculator' && <RankPercentileCalculator client:load />}
    {tool.component === 'speed-distance-time-calculator' && <SpeedDistanceTimeCalculator client:load />}
    {tool.component === 'bmi-calculator' && <BmiCalculator client:load />}
    {tool.component === 'random-number-generator' && <RandomNumberGenerator client:load />}
    {tool.component === 'sgpa-calculator' && <SgpaCalculator client:load />}
    {tool.component === 'grade-predictor' && <GradePredictor client:load />}
    {tool.component === 'case-converter' && <CaseConverter client:load />}
    {tool.component === 'team-splitter' && <TeamSplitter client:load />}
    {tool.component === 'color-converter' && <ColorConverter client:load />}
    {tool.component === 'sip-calculator' && <SipCalculator client:load />}
    {tool.component === 'ctc-to-inhand' && <CtcToInHandCalculator client:load />}
    {tool.component === 'freelance-rate' && <FreelanceRateCalculator client:load />}
    {tool.component === 'break-even' && <BreakEvenCalculator client:load />}
    {tool.component === 'income-tax' && <IncomeTaxCalculator client:load />}
    {tool.component === 'countdown-timer' && <CountdownTimer client:load />}
    {tool.component === 'working-days-calculator' && <WorkingDaysCalculator client:load />}
    {tool.component === 'sleep-cycle-calculator' && <SleepCycleCalculator client:load />}
    {tool.component === 'age-gap-calculator' && <AgeGapCalculator client:load />}
    {tool.component === 'time-math-calculator' && <TimeAddSubtract client:load />}
    {tool.component === 'projectile-motion' && <ProjectileMotionCalculator client:load />}
    {tool.component === 'density-calculator' && <DensityCalculator client:load />}
    {tool.component === 'work-power-calculator' && <WorkPowerCalculator client:load />}
    {tool.component === 'bmr-calculator' && <BmrCalculator client:load />}
    {tool.component === 'water-intake-calculator' && <WaterIntakeCalculator client:load />}
    {tool.component === 'ideal-weight-calculator' && <IdealWeightCalculator client:load />}
    {tool.component === 'pregnancy-due-date' && <PregnancyDueDateCalculator client:load />}
    {tool.component === 'fire-calculator' && <FireCalculator client:load />}
    {tool.component === 'body-fat-calculator' && <BodyFatCalculator client:load />}
    {tool.component === 'heart-rate-zones' && <HeartRateZonesCalculator client:load />}
    {tool.component === 'waist-to-hip-ratio' && <WaistToHipCalculator client:load />}
    {tool.component === 'one-rep-max' && <OneRepMaxCalculator client:load />}
    {tool.component === 'pace-calculator' && <PaceCalculator client:load />}





    </div>

    <AdSlot />

    {tool.sections.map((section) => (
      <section class="mt-10">
        <h2 class="font-display text-[26px] font-semibold">{section.heading}</h2>
        <p class="mt-2 leading-relaxed text-ink/80 dark:text-ink/70" set:html={section.body} />
      </section>
    ))}

    <section class="mt-12" aria-labelledby="related-heading">
      <h2 id="related-heading" class="font-display text-[26px] font-semibold">Related tools</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {related.map((t) => (
          <a href={'/tools/' + t.slug + '/'} class="card-paper group flex items-center gap-3 p-4">
            <span class="text-soft transition-colors duration-150 group-hover:text-desk"><ToolIcon name={t.slug} class="h-5 w-5" /></span>
            <span class="text-sm font-semibold">{t.title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-display text-[26px] font-semibold">Frequently asked questions</h2>
      <div class="mt-4 space-y-3">
        {tool.faqs.map((faq) => (
          <details class="card-paper p-4">
            <summary class="cursor-pointer font-semibold">{faq.q}</summary>
            <p class="mt-2 text-sm leading-relaxed text-soft">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
