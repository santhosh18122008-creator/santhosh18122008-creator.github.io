---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ui/ToolIcon.astro';
import { publishedTools } from '../content/tools';
import { publishedGuides } from '../content/guides';

const categoryOrder = ['student-tools', 'general-utilities', 'physics-tools', 'everyday-tools', 'finance-tools'];
const categoryLabels: Record<string, string> = {
  'student-tools': 'Student Tools',
  'general-utilities': 'Everyday Utilities',
  'physics-tools': 'Physics & Engineering',
  'everyday-tools': 'Date & Time',
  'finance-tools': 'Money & Finance',
};
const groups = categoryOrder
  .map((c) => ({ category: c, label: categoryLabels[c], tools: publishedTools.filter((t) => t.category === c) }))
  .filter((g) => g.tools.length > 0);
const latestGuides = [...publishedGuides].slice(-3).reverse();
---
<BaseLayout
  title="MarqDesk — Free tools for students and everyday tasks"
  description="MarqDesk is a fast, free collection of simple online tools for students and everyday tasks. No sign-up and nothing to install — everything runs in your browser."
>
  <section class="hero-bg -mx-4 px-4 py-20 text-center sm:py-24">
    <span class="chip">100% free · No sign-up · Private by design</span>
    <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-6xl">
      Every tool you need, <span class="text-gradient">one desk away</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
      Calculators, converters, and generators for students and everyday life.
      Fast, simple, and everything runs right in your browser.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/tools/" class="btn-primary">Browse all {publishedTools.length} tools</a>
      <a href="/guides/" class="btn-secondary">Read the guides</a>
    </div>
  </section>

  {groups.map((group) => (
    <section class="mt-14" aria-labelledby={'cat-' + group.category}>
      <div class="flex items-end justify-between">
        <h2 id={'cat-' + group.category} class="text-2xl font-bold tracking-tight">{group.label}</h2>
        <a href="/tools/" class="text-sm font-semibold text-brand-600 hover:underline">View all →</a>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {group.tools.map((tool) => (
          <a href={'/tools/' + tool.slug + '/'} class="card group flex flex-col p-5">
            <div class="flex items-start justify-between">
              <span class="icon-badge"><ToolIcon name={tool.slug} /></span>
              <span class="text-xs font-semibold text-slate-400">Free</span>
            </div>
            <h3 class="mt-4 font-bold text-slate-900 dark:text-white">{tool.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{tool.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="mt-20 rounded-2xl border border-slate-200 bg-white p-8 shadow-card dark:border-slate-800 dark:bg-slate-900 sm:p-10">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <h3 class="font-bold">⚡ Instant & lightweight</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">Static pages that load in a blink, even on slow connections and older phones.</p>
      </div>
      <div>
        <h3 class="font-bold">🔒 Private by design</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">Calculations happen on your device. Your inputs are never uploaded or stored.</p>
      </div>
      <div>
        <h3 class="font-bold">🎓 Built for students</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">Grades, GPA, attendance, physics formulas, and more — the tools you actually use.</p>
      </div>
    </div>
  </section>

  <section class="mt-14" aria-labelledby="guides-heading">
    <div class="flex items-end justify-between">
      <h2 id="guides-heading" class="text-2xl font-bold tracking-tight">Latest guides</h2>
      <a href="/guides/" class="text-sm font-semibold text-brand-600 hover:underline">All guides →</a>
    </div>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      {latestGuides.map((guide) => (
        <a href={'/guides/' + guide.slug + '/'} class="card group flex flex-col p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Guide</p>
          <h3 class="mt-2 font-bold leading-snug text-slate-900 dark:text-white">{guide.title}</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{guide.description}</p>
        </a>
      ))}
    </div>
  </section>
  <div class="h-4"></div>
</BaseLayout>
