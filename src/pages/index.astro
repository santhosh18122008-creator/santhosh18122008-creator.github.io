---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedTools } from '../content/tools';
const featured = publishedTools.filter((t) => t.featured);
---
<BaseLayout
  title="MarqDesk — Free tools for students and everyday tasks"
  description="MarqDesk is a fast, free collection of simple online tools for students and everyday tasks. No sign-up and nothing to install — everything runs in your browser."
>
  <section class="text-center">
    <h1 class="text-4xl font-extrabold tracking-tight text-brand-900 dark:text-brand-100 sm:text-5xl">
      Free tools for students and everyday tasks
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
      Fast, simple, and private. Every tool runs directly in your browser — nothing to install and no account required.
    </p>
    <div class="mt-6">
      <a
        href="/tools/"
        class="inline-block rounded-md bg-brand-900 px-6 py-3 font-semibold text-white hover:bg-brand-800 dark:bg-brand-500 dark:hover:bg-brand-600"
      >
        Browse all tools
      </a>
    </div>
  </section>

  <section class="mt-14" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="text-2xl font-bold">Featured tool</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-1">
      {featured.map((tool) => (
        <a
          href={'/tools/' + tool.slug + '/'}
          class="block rounded-lg border border-slate-200 bg-white p-6 hover:border-brand-500 dark:border-slate-800 dark:bg-slate-900"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{tool.category}</p>
          <h3 class="mt-1 text-xl font-bold">{tool.title}</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-400">{tool.shortDescription}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-14" aria-labelledby="why-heading">
    <h2 id="why-heading" class="text-2xl font-bold">Why MarqDesk?</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h3 class="font-semibold">Fast</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Static pages that load quickly on any device, even on slow connections.</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h3 class="font-semibold">Private</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Calculations happen on your device. Your inputs are never uploaded.</p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h3 class="font-semibold">Free</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">No account, no installation, no paywall. Just open a tool and use it.</p>
      </div>
    </div>
  </section>

  <section class="mt-14" aria-labelledby="students-heading">
    <h2 id="students-heading" class="text-2xl font-bold">Built with students in mind</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-400">
      MarqDesk starts with the tools students reach for most — like percentages for grades, marks, and attendance. More student tools are on the way.
    </p>
    <p class="mt-3">
      <a class="font-semibold text-brand-600 hover:underline" href="/tools/percentage-calculator/">Try the Percentage Calculator →</a>
    </p>
  </section>
</BaseLayout>
