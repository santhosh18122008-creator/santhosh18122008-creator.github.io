---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolIcon from '../components/ui/ToolIcon.astro';
import { publishedTools } from '../content/tools';
import { publishedGuides } from '../content/guides';

const categoryOrder = ['student-tools', 'general-utilities', 'physics-tools', 'everyday-tools', 'finance-tools'];
const categoryLabels: Record<string, string> = {
  'student-tools': 'Student tools',
  'general-utilities': 'Everyday utilities',
  'physics-tools': 'Physics and engineering',
  'everyday-tools': 'Date and time',
  'finance-tools': 'Money and finance',
};
const groups = categoryOrder
  .map((c) => ({ category: c, label: categoryLabels[c], tools: publishedTools.filter((t) => t.category === c) }))
  .filter((g) => g.tools.length > 0);
const latestGuides = [...publishedGuides].slice(-3).reverse();
---
<BaseLayout
  title="MarqDesk — Free tools for students and everyday tasks"
  description="MarqDesk is a fast, free collection of simple online tools for students and everyday tasks. No sign-up and nothing to install — everything runs in your browser."
>
  <section class="py-16 text-center sm:py-20">
    <p class="text-sm font-medium text-soft">Free, private tools that run in your browser</p>
    <h1 class="font-display mx-auto mt-4 max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl">
      A quiet desk for every calculation
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-soft">
      Calculators, converters, and generators for students and everyday life. Enter your numbers, get a clear answer, and get back to work.
    </p>
    <div class="mt-8 flex items-center justify-center gap-5">
      <a href="/tools/" class="btn-filled">Browse the tools</a>
      <a href="/guides/" class="btn-text">Read the guides</a>
    </div>
  </section>

  {groups.map((group) => (
    <section class="mt-12" aria-labelledby={'cat-' + group.category}>
      <div class="flex items-end justify-between">
        <h2 id={'cat-' + group.category} class="font-display text-2xl font-semibold">{group.label}</h2>
        <a href="/tools/" class="btn-text">View all</a>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {group.tools.map((tool) => (
          <a href={'/tools/' + tool.slug + '/'} class="card-paper group flex flex-col p-5">
            <span class="text-soft transition-colors duration-150 group-hover:text-desk"><ToolIcon name={tool.slug} class="h-5 w-5" /></span>
            <h3 class="mt-3 font-semibold">{tool.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-soft">{tool.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="mt-16">
    <h2 class="font-display text-2xl font-semibold">Why MarqDesk</h2>
    <div class="mt-4 grid gap-8 sm:grid-cols-3">
      <div>
        <h3 class="font-semibold">Instant and lightweight</h3>
        <p class="mt-2 text-sm leading-relaxed text-soft">Static pages that load in a blink, even on slow connections and older phones.</p>
      </div>
      <div>
        <h3 class="font-semibold">Private by design</h3>
        <p class="mt-2 text-sm leading-relaxed text-soft">Calculations happen on your device. Your inputs are never uploaded or stored.</p>
      </div>
      <div>
        <h3 class="font-semibold">Built for students</h3>
        <p class="mt-2 text-sm leading-relaxed text-soft">Grades, GPA, attendance, physics formulas, and the math you actually use.</p>
      </div>
    </div>
  </section>

  <section class="mt-16" aria-labelledby="guides-heading">
    <div class="flex items-end justify-between">
      <h2 id="guides-heading" class="font-display text-2xl font-semibold">Latest guides</h2>
      <a href="/guides/" class="btn-text">All guides</a>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {latestGuides.map((guide) => (
        <a href={'/guides/' + guide.slug + '/'} class="card-paper group flex flex-col p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-soft">Guide</p>
          <h3 class="mt-2 font-semibold leading-snug">{guide.title}</h3>
          <p class="mt-2 text-sm text-soft">{guide.description}</p>
        </a>
      ))}
    </div>
  </section>
  <div class="h-8"></div>
</BaseLayout>
