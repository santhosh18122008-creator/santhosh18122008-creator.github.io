---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedGuides } from '../../content/guides';
---
<BaseLayout title="Guides & Articles — Student and Utility Guides | MarqDesk" description="Helpful guides and articles about math, productivity, security, and getting the most out of MarqDesk's free online tools.">
  <h1 class="text-3xl font-extrabold text-brand-900 dark:text-brand-100">Guides & Articles</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-400">Helpful guides to improve your math skills, productivity, and online security.</p>
  <div class="mt-8 space-y-6">
    {publishedGuides.map((guide) => (
      <a href={'/guides/' + guide.slug + '/'} class="block rounded-lg border border-slate-200 bg-white p-6 hover:border-brand-500 dark:border-slate-800 dark:bg-slate-900">
        <p class="text-xs text-slate-500 dark:text-slate-400">{new Date(guide.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        <h2 class="mt-1 text-xl font-bold text-brand-900 dark:text-brand-100">{guide.title}</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">{guide.description}</p>
        <p class="mt-3 text-sm font-semibold text-brand-600">Read more →</p>
      </a>
    ))}
  </div>
</BaseLayout>
