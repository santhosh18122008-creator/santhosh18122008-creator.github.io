---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { publishedGuides, getGuide } from '../../content/guides';
import { publishedTools } from '../../content/tools';

export function getStaticPaths() {
  return publishedGuides.map((guide) => ({ params: { slug: guide.slug } }));
}

const guide = getGuide(Astro.params.slug as string);
if (!guide) return new Response('Not found', { status: 404 });

const related = publishedTools.filter((t) => guide.relatedTools.includes(t.slug));

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article', headline: guide.title,
  description: guide.seoDescription, datePublished: guide.publishDate,
  url: new URL('/guides/' + guide.slug + '/', import.meta.env.SITE).href,
};
---
<BaseLayout title={guide.seoTitle} description={guide.seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <nav aria-label="Breadcrumb" class="mb-4 text-sm text-slate-500">
    <a href="/" class="hover:underline">Home</a> / <a href="/guides/" class="hover:underline">Guides</a> / <span>{guide.title}</span>
  </nav>

  <article class="prose dark:prose-invert max-w-none">
    <h1 class="text-3xl font-extrabold text-brand-900 dark:text-brand-100">{guide.title}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">{new Date(guide.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    <p class="lead text-lg text-slate-600 dark:text-slate-400">{guide.description}</p>
  <AdSlot />

    {guide.sections.map((section) => (
      <section class="mt-8">
        <h2 class="text-2xl font-bold">{section.heading}</h2>
        <p class="mt-2 leading-relaxed text-slate-700 dark:text-slate-300" set:html={section.body} />
      </section>
    ))}
  </article>

  {related.length > 0 && (
    <section class="mt-12 border-t border-slate-200 pt-8 dark:border-slate-800" aria-labelledby="related-tools-heading">
      <h2 id="related-tools-heading" class="text-xl font-bold">Try our related tools</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {related.map((tool) => (
          <a href={'/tools/' + tool.slug + '/'} class="block rounded-lg border border-slate-200 bg-white p-4 hover:border-brand-500 dark:border-slate-800 dark:bg-slate-900">
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{tool.category}</p>
            <h3 class="mt-1 text-lg font-bold">{tool.title}</h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{tool.shortDescription}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
