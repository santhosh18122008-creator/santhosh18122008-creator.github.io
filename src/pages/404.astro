---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found | MarqDesk"
  description="The page you are looking for does not exist. Return to MarqDesk's free online tools."
>
  <div class="text-center">
    <p class="text-6xl font-extrabold text-brand-900 dark:text-brand-100">404</p>
    <h1 class="mt-4 text-2xl font-bold">Page not found</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      The page you are looking for doesn't exist or has been moved.
    </p>
    <div class="mt-6 flex justify-center gap-4">
      <a href="/" class="rounded-md bg-brand-900 px-5 py-2 font-medium text-white hover:bg-brand-800 dark:bg-brand-500">Go home</a>
      <a href="/tools/" class="rounded-md border border-slate-300 px-5 py-2 hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Browse tools</a>
    </div>
  </div>
</BaseLayout>
