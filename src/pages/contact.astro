---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | MarqDesk" description="How to contact the MarqDesk team with feedback, bug reports, or tool requests.">
  <h1 class="text-3xl font-extrabold text-brand-900 dark:text-brand-100">Contact</h1>
  <div class="mt-6 leading-relaxed text-slate-700 dark:text-slate-300">
    <p>Found a bug? Want a specific tool added? Have feedback?</p>
    <p class="mt-3">
      MarqDesk is developed in the open. The most reliable way to reach us is through the public GitHub repository — open an issue describing your feedback or request:
    </p>
    <p class="mt-3">
      <a class="font-semibold text-brand-600 hover:underline" href="https://github.com/santhosh18122008-creator/santhosh18122008-creator.github.io" target="_blank" rel="noopener noreferrer">
        MarqDesk on GitHub
      </a>
    </p>
  </div>
</BaseLayout>
